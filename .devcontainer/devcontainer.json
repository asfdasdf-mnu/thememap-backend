{
  "name": "ThemeMap FastAPI + PostgreSQL",
  "dockerComposeFile": "../compose.yaml",
  "service": "api",
  "workspaceFolder": "/workspace",
  "overrideCommand": true,
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "portsAttributes": {"8000": {"label": "ThemeMap API", "onAutoForward": "notify"}},
  "postCreateCommand": "python -m app.migrate && python -m app.seed",
  "customizations": {"vscode": {"extensions": ["ms-python.python"]}}
}
